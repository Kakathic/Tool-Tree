<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/banner_bg_base">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/banner_info_start"
                android:endColor="@color/banner_info_end" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="220%"
                android:startColor="#42FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
