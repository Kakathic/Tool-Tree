<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/dialogRootSmall"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:visibility="gone"
        android:id="@+id/search_bar"
        android:background="@drawable/dialog_search_bg"
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <EditText
            android:id="@+id/search_box"
            android:nextFocusDown="@id/search_box"
            android:lines="1"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:maxLength="30"
            android:textSize="15dp"
            android:hint="@string/item_chooser_search_hint"
            android:background="@null" />

        <ImageButton
            android:id="@+id/search_box_clear"
            android:background="@null"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/dialog_search_clear"
            android:scaleType="centerInside"
            android:padding="15dp"
            android:tint="?android:attr/textColorPrimary"
            android:layout_width="50dp"
            android:layout_height="50dp" />
    </RelativeLayout>

    <FrameLayout
        android:layout_marginBottom="8dp"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            style="@style/dialogTitle"
            android:breakStrategy="simple"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:id="@+id/dialog_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/dialogDesc"
            android:breakStrategy="simple"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:id="@+id/dialog_desc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <!-- Khung chứa chung mang background krscript_item_ripple_kon -->
    <LinearLayout
        android:background="@drawable/krscript_item_ripple_kon"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ListView
            android:paddingEnd="5dp"
            android:id="@+id/item_list"
            android:scrollbarSize="0dp"
            android:divider="@null"
            android:fastScrollEnabled="true"
            android:scrollbarStyle="insideOverlay"
            android:requiresFadingEdge="vertical"
            android:smoothScrollbar="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Đường kẻ phân cách -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />
            
        <LinearLayout
            android:id="@+id/bottom_buttons"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <Button
                android:id="@+id/btn_cancel"
                style="@style/dialogCancelBtn"
                android:text="@string/btn_cancel">
            </Button>
            <Button
                android:id="@+id/btn_confirm"
                style="@style/dialogConfirmBtn"
                android:text="@string/btn_confirm">
            </Button>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
