<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:id="@+id/dialog_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/about_card_bg"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/about_panel"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="4dp"
                android:text="@string/about_title" android:textColor="?android:attr/textColorPrimary"
                android:textSize="21sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="14dp"
                android:text="@string/about_desc" android:alpha="0.7"
                android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
            <View android:id="@+id/about_band0" android:layout_width="match_parent" android:layout_height="8dp" android:background="?attr/colorParse" />
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:overScrollMode="never" android:requiresFadingEdge="vertical" android:scrollbars="none">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/about_version_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView 
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/app_name" android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
                    <TextView
                        android:id="@+id/about_version" android:layout_width="wrap_content" android:layout_height="wrap_content"
                         android:alpha="0.7" android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" />
                </LinearLayout>
                <View android:id="@+id/about_div1" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="?attr/colorPirm" />
                <LinearLayout
                    android:id="@+id/about_author_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/about_author"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/author_name" android:alpha="0.7" android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" />
                </LinearLayout>
                <View android:id="@+id/about_div_author" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="?attr/colorPirm" />
                <LinearLayout
                    android:id="@+id/about_update_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView 
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/about_latest_version"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
                    <View android:id="@+id/about_update_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:background="@drawable/about_dot_red" android:visibility="gone" />
                    <TextView
                        android:id="@+id/about_update_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/about_check" android:alpha="0.7" android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" />
<ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="2dp" android:alpha="0.5" android:src="@drawable/kr_arrow" android:tint="?android:attr/textColorPrimary" android:importantForAccessibility="no" />
                </LinearLayout>
                <View android:id="@+id/about_band1" android:layout_width="match_parent" android:layout_height="8dp" android:background="?attr/colorParse" />
                <LinearLayout
                    android:id="@+id/theme_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <TextView 
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/theme_text"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
                    <LinearLayout android:id="@+id/theme_segment" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/about_seg_bg" android:orientation="horizontal" android:padding="3dp">
                        <TextView android:id="@+id/theme_seg_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:clickable="true" android:focusable="true" android:gravity="center"
                            android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="7dp" android:paddingBottom="7dp"
                            android:text="@string/about_theme_system" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                        <TextView android:id="@+id/theme_seg_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:clickable="true" android:focusable="true" android:gravity="center"
                            android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="7dp" android:paddingBottom="7dp"
                            android:text="@string/about_theme_dark" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                        <TextView android:id="@+id/theme_seg_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:clickable="true" android:focusable="true" android:gravity="center"
                            android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="7dp" android:paddingBottom="7dp"
                            android:text="@string/about_theme_light" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
                <View android:id="@+id/about_div2" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="?attr/colorPirm" />
                <LinearLayout
                    android:id="@+id/blur_disable_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView android:id="@+id/blur_disable_label"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/theme_disable_blur"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
                    <Switch android:id="@+id/blur_disable_check" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:clickable="false" android:focusable="false" android:textOff="" android:textOn=""
                        android:switchTextAppearance="@null" android:track="@drawable/kr_switch_track" android:thumb="@drawable/kr_switch_thumb" />
                </LinearLayout>
                <View android:id="@+id/about_div3" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="?attr/colorPirm" />
                <LinearLayout
                    android:id="@+id/direct_bg_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView android:id="@+id/direct_bg_label"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/theme_direct_bg"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
                    <Switch android:id="@+id/direct_bg_check" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:clickable="false" android:focusable="false" android:textOff="" android:textOn=""
                        android:switchTextAppearance="@null" android:track="@drawable/kr_switch_track" android:thumb="@drawable/kr_switch_thumb" />
                </LinearLayout>
                <View android:id="@+id/about_div4" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="?attr/colorPirm" />
                <LinearLayout
                    android:id="@+id/wallpaper_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView 
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/about_wallpaper"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
                    <TextView
                        android:id="@+id/wallpaper_path" android:layout_width="wrap_content" android:layout_height="wrap_content"
                         android:alpha="0.7" android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" android:layout_marginEnd="4dp" android:ellipsize="end" android:singleLine="true" android:maxWidth="150dp" />
<ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="2dp" android:alpha="0.5" android:src="@drawable/kr_arrow" android:tint="?android:attr/textColorPrimary" android:importantForAccessibility="no" />
                </LinearLayout>
                <View android:id="@+id/about_band2" android:layout_width="match_parent" android:layout_height="8dp" android:background="?attr/colorParse" />
                <LinearLayout
                    android:id="@+id/about_donate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView 
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/about_donate"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
<ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="2dp" android:alpha="0.5" android:src="@drawable/kr_arrow" android:tint="?android:attr/textColorPrimary" android:importantForAccessibility="no" />
                </LinearLayout>
                <View android:id="@+id/about_div5" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="?attr/colorPirm" />
                <LinearLayout
                    android:id="@+id/about_telegram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView 
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/about_telegram"
                        android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
<ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="2dp" android:alpha="0.5" android:src="@drawable/kr_arrow" android:tint="?android:attr/textColorPrimary" android:importantForAccessibility="no" />
                </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/update_panel"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/update_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/update_text" android:textColor="?android:attr/textColorPrimary"
                            android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:id="@+id/update_version" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:textColor="@color/colorAccent"
                            android:textSize="22sp" android:textStyle="bold" android:visibility="gone" />
                    </LinearLayout>
                    <com.omarea.krscript.ui.DownloadProgressRing
                        android:id="@+id/update_ring" android:layout_width="22dp" android:layout_height="22dp"
                        android:layout_marginStart="10dp" android:visibility="gone" />
                    <TextView android:id="@+id/update_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:background="@drawable/about_btn_accent"
                        android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingStart="14dp" android:paddingTop="7dp" android:paddingEnd="14dp" android:paddingBottom="7dp"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/update_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:alpha="0.7" android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="?attr/colorParse" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="20dp" android:paddingTop="14dp" android:paddingEnd="20dp" android:paddingBottom="8dp"
                android:alpha="0.8" android:letterSpacing="0.08" android:text="@string/about_changelog" android:textAllCaps="true"
                android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" android:textStyle="bold" />
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:overScrollMode="never" android:requiresFadingEdge="vertical" android:scrollbars="none">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingStart="20dp" android:paddingTop="6dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
                    <LinearLayout android:id="@+id/update_timeline" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <TextView android:id="@+id/update_log" style="@style/textSmall" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textIsSelectable="true" android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
