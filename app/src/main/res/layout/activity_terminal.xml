<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/terminal_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical">

        <com.termux.view.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAutofill="no"
            android:scrollbars="none" />

        <com.tool.tree.TerminalSwipePager
            android:id="@+id/terminal_toolbar_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000">

            <LinearLayout
                android:id="@+id/terminal_extra_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/terminal_input_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/terminal_input_back"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌨"
                    android:textColor="#8A8A8A"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/terminal_input_edit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/terminal_input_bg"
                    android:hint="@string/terminal_input_hint"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6A6A6A"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.tool.tree.TerminalSwipePager>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/terminal_drawer_panel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1B1B1B"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/terminal_sessions"
            android:textColor="#8A8A8A"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/terminal_session_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/terminal_new_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#262626"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/terminal_new_session"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
