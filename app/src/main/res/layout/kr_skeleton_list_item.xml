<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/krscript_item_ripple_inactive"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="?android:attr/listPreferredItemHeight"
            android:paddingTop="15dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/kr_skeleton_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/kr_skeleton_block_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <View
                    android:layout_width="150dp"
                    android:layout_height="14dp"
                    android:background="@drawable/kr_skeleton_block_bg" />

                <View
                    android:layout_width="100dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/kr_skeleton_block_bg" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/kr_skeleton_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/kr_skeleton_shimmer_gradient" />
    </FrameLayout>
</LinearLayout>
