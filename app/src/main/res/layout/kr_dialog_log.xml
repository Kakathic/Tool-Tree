<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/dialogRoot"
    android:animateLayoutChanges="true"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/dialogTitle"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp" />

            <TextView
                android:id="@+id/desc"
                style="@style/dialogDesc"
                android:layout_marginTop="4dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/top_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/kr_log_action_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <ImageButton
                android:id="@+id/btn_wrap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_wrap_text" />

            <View
                android:id="@+id/btn_divider"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:background="?android:attr/listDivider" />

            <ImageButton
                android:id="@+id/btn_hide"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/kr_hide" />

        </LinearLayout>

    </LinearLayout>

    <!-- 1. Thêm android:fillViewport="true" vào ScrollView -->
    <ScrollView
        android:id="@+id/log_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/choose_row"
        android:layout_below="@+id/header_row"
        android:layout_marginTop="14dp"
        android:background="@drawable/kr_log_panel_bg"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbarSize="2dp">

        <!-- 2. Đổi layout_height của TextView thành match_parent -->
        <TextView
            android:id="@+id/shell_output"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:breakStrategy="simple"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </ScrollView>

    <!-- Hàng các nút lựa chọn, hiển thị khi script yêu cầu chọn phương án qua cú pháp
         "choose:[gia_tri_1|nhan_1,gia_tri_2|nhan_2,...]". Ẩn mặc định, chỉ hiện khi có yêu cầu.
         Đặt layout_above="@id/input_row" để khi GONE không chiếm chỗ (giống cách input_row
         đang hoạt động), và khi hiện lên sẽ đẩy log_scroll_view thu nhỏ lại tương ứng. -->
    <HorizontalScrollView
        android:id="@+id/choose_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/input_row"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/choose_options_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_actions"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/shell_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="monospace"
            android:hint="@string/hint_shell_input"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_copy"
            style="@style/dialogCancelBtn"
            android:layout_weight="1"
            android:text="@string/btn_copy_output" />

        <Button
            android:id="@+id/btn_cancel"
            style="@style/dialogWarningBtn"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_exit"
            style="@style/dialogConfirmBtn"
            android:layout_weight="1"
            android:text="@string/btn_exit" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/action_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignTop="@id/log_scroll_view"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/kr_log_progress_indeterminate_md"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/kr_log_progress_determinate" />

</RelativeLayout>
