<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu trúc giống kr_dialog_params.xml: KHÔNG còn khối "hộp vuông" bo góc bọc riêng
  (krscript_item_ripple_kon) - tiêu đề cố định ở đỉnh (top_bar), nút bấm cố định ở đáy
  (bottom_actions), nội dung text giãn lấp khoảng giữa 2 khối đó và tự cuộn bên trong.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- 1. Thanh tiêu đề cố định ở ĐỈNH -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/update_title"
            android:breakStrategy="simple"
            style="@style/dialogTitle"
            android:text="@string/app_update_title" />
        <TextView
            android:id="@+id/update_desc"
            android:breakStrategy="simple"
            style="@style/dialogDesc"
            android:text="@string/app_update_desc" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar">

        <!-- 2. Khối cố định ở ĐÁY: tiến trình + 2 nút -->
        <LinearLayout
            android:id="@+id/bottom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <!-- Thanh tiến trình: tải nội dung text khi mở dialog, tiến trình tải apk khi bấm
                 xác nhận. Mặc định INVISIBLE (không phải GONE) để luôn giữ chỗ cố định - ẩn/hiện
                 không làm xê dịch layout (vị trí nội dung/nút bấm không đổi). -->
            <ProgressBar
                android:id="@+id/update_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="16dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="true"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/update_btn_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <Button
                    android:id="@+id/btn_cancel"
                    style="@style/dialogCancelBtn"
                    android:text="@string/btn_cancel" />
                <Button
                    android:id="@+id/btn_confirm"
                    style="@style/dialogConfirmBtn"
                    android:text="@string/app_update_btn_confirm" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Nội dung cập nhật, tải TEXT thuần từ Version.md online (xem
             AppUpdateChecker.CHANGELOG_URL) - nằm GIỮA top_bar và bottom_actions, tự cuộn bên
             trong ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottom_actions"
            android:requiresFadingEdge="vertical"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/update_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" />
        </ScrollView>

    </RelativeLayout>

</RelativeLayout>
