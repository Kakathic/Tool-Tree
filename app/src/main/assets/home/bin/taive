#!/data/data/com.tool.tree/files/home/bin/bash

if [[ "$1" =~ ^(-h|--help)$ ]] || [ -z "$1" ]; then
    echo "Syntax: taive [-#|-w|-s|-a] http://file.zip [path/save.zip]"
    exit 0
fi

# Tách cờ tùy chọn nếu có
FLAG=""
case "$1" in
    -#|-w|-s|-a) FLAG="$1"; shift ;;
esac

# Đường dẫn lưu
SAVE_PATH="${2:-${1##*/}}"
SAVE_PATH="${SAVE_PATH:-downloaded_file}"

if [ ! -f "$(which curl)" ]; then
    FLAG="-w"
fi

# Thực thi công cụ tải
case "$FLAG" in
    -#) curl -f -# --connect-timeout 20 --speed-time 15 --speed-limit 1000 --retry 2 --retry-delay 2 -L -H "$WEBS" "$1" -o "$SAVE_PATH" ;;
    -s) curl -sSf --connect-timeout 20 --speed-time 15 --speed-limit 1000 --retry 2 --retry-delay 2 -L -H "$WEBS" "$1" -o "$SAVE_PATH" ;;
    -a) axel -q -o "$SAVE_PATH" "$1" ;;
    -w) wget --header "$WEBS" --no-check-certificate -O "$SAVE_PATH" "$1" ;;
     *) curl -f --connect-timeout 20 --speed-time 15 --speed-limit 1000 --retry 2 --retry-delay 2 -L -H "$WEBS" "$1" -o "$SAVE_PATH" ;;
esac
