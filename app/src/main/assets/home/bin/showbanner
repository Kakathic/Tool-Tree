#!/data/data/com.tool.tree/files/home/bin/bash

show_help(){
echo "Use: showbanner -t|--title 'Hello' -m|--message 'Xin chào'"
echo
echo "-y|--type: info, warning, success, error"
echo "-i|--icon: path/icon.png, kr_shortcut_logo"
echo "-p|--position: top, bottom"
echo "-s|--script: 'echo 1'"
echo "-o|--config: config file path for the page to open when Confirm is tapped"
echo "-e|--config-sh: command that generates the config for the page to open when Confirm is tapped"
echo "-d|--id: item id in the config page to open/run right after the page opens"
echo "-c|--confirm: confirm"
echo "-n|--cancel: cancel"
echo "-g|--countdown: 5"
}

if [[ $# -eq 0 || "$1" != -* ]]; then
show_help >&2
exit 1
fi

TYPE= ICON= TITLE= MESSAGE= POSITION= AMON=
SCRIPT= CONFIG= CONFIGSH= ITEMID= CONFIRM= CANCEL= COUNTDOWN=5
while [ $# -gt 0 ]; do
  case "$1" in
    -y|--type)
      TYPE="$2"
      shift 2
      ;;
    -i|--icon)
      ICON="$2"
      shift 2
      ;;
    -p|--position)
      POSITION="$2"
      shift 2
      ;;
    -t|--title)
      TITLE="$2"
      shift 2
      ;;
    -m|--message)
      MESSAGE="$2"
      shift 2
      ;;
    -s|--script)
      SCRIPT="$2"
      shift 2
      ;;
    -o|--config)
      CONFIG="$2"
      shift 2
      ;;
    -e|--config-sh)
      CONFIGSH="$2"
      shift 2
      ;;
    -d|--id)
      ITEMID="$2"
      shift 2
      ;;
    -c|--confirm)
      CONFIRM="$2"
      shift 2
      ;;
    -n|--cancel)
      CANCEL="$2"
      shift 2
      ;;
    -g|--countdown)
      COUNTDOWN="$2"
      shift 2
      ;;
    -a|--am)
      AMON=1
      shift
      ;;
    -h|--help)
      show_help
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# Mặc định
CMDs="broadcast -n com.tool.tree/com.tool.tree.BannerReceiver -a com.tool.tree.broadcast.BANNER "

[ "$TYPE" ] && CMDs+="--es type \"$TYPE\" "
[ "$ICON" ] && CMDs+="--es icon \"$ICON\" "
[ "$POSITION" ] && CMDs+="--es position \"$POSITION\" "
[ "$TITLE" ] && CMDs+="--es title \"$TITLE\" "
[ "$MESSAGE" ] && CMDs+="--es text \"$MESSAGE\" "
[ "$SCRIPT" ] && CMDs+="--es script \"$SCRIPT\" "
[ "$CONFIG" ] && CMDs+="--es config \"$CONFIG\" "
[ "$CONFIGSH" ] && CMDs+="--es config-sh \"$CONFIGSH\" "
[ "$ITEMID" ] && CMDs+="--es id \"$ITEMID\" "
[ "$CONFIRM" ] && CMDs+="--es confirm \"$CONFIRM\" "
[ "$CANCEL" ] && CMDs+="--es cancel \"$CANCEL\" "
[ "$COUNTDOWN" ] && CMDs+="--ei countdown \"$COUNTDOWN\" "

if [ "$AMON" == 1 ] || [ -z "$shell_progres" ]; then
    eval "am $CMDs" &>/dev/null
else
    echo "am:[$CMDs]"
fi
