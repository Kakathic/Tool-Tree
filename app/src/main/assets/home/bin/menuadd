#!/data/data/com.tool.tree/files/home/bin/bash
# Kakathic

fileprop="$1/Add-on.bash"
if [ -d "$1" ] && [ -f "$fileprop" ]; then
source language 2>/dev/null
source "$fileprop" 2>/dev/null

[ -f "$1/pin" ] && pin_text_add="$unpin_text" || pin_text_add="$pin_text"
echo '
  [[group]]
  [[menu]]
  [[menu.items]]
  title = "'$pin_text_add'"
  get = "[ -f '$1'/pin ] && echo 1"
  type = "checkbox"
  silent = true
  script = """
  if [ -f "'$1'/pin" ]; then
  rm -f "'$1'/pin"
  else
  echo > "'$1'/pin"
  fi
  """
  [[end]]
  '
fi

if [ "$google_text" ] || [ "$transai" == "true" ]; then
  if [ "$(glog "transai_text_$id")" == 1 ] && [ "$transai" == "true" ]; then
    summ="$(checksum "$1/lang/default.bash")"
    if [ "$summ" != "$(glog "sum_$id")" ] || [ ! -f "$1/lang/auto.bash" ]; then
      check_trans="$(transai < "$1/lang/default.bash")"
      if [[ "$check_trans" ]]; then
      echo "$check_trans" > "$1/lang/auto.bash" 2>/dev/null
      slog "sum_$id" "$summ"
      fi
    fi
  fi
  echo '
  [[menu.items]]
  title = "Gemini"
  get = "glog transai_text_'$id'"
  reload = true
  silent = true
  type = "checkbox"
  script = """
  if [ "$(glog transai_text_'$id')" == 1 ]; then
  slog transai_text_'$id' 0
  rm -fr "'$1'/lang/auto.bash" 2>/dev/null
  else
  [[ -n "$(glog api_genmini)" ]] && slog transai_text_'$id' 1 || showdialog -t "Gemini" -m "'$warn_gemini_text'" --id "gemini_api" -g 15 -e "'$ETC'/toml/feature.toml"
  fi
  """
  [[end]]
  '
fi
