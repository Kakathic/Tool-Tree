#!/data/data/com.tool.tree/files/home/bin/bash
# Kakathic

fileprop="$1/Add-on.bash"

if [ -d "$1" ] && [ -f "$fileprop" ]; then
source language 2>/dev/null
source "$fileprop" 2>/dev/null

[ -f "$1/pin" ] && pin_text_add="$unpin_text" || pin_text_add="$pin_text"
echo '
  [[group]]
  [[menu]]
  [[menu.items]]
  title = "'$pin_text_add'"
  get = "[ -f '$1'/pin ] && echo 1"
  auto-finish = true
  type = "checkbox"
  silent = true
  script = """
  if [ -f "'$1'/pin" ]; then
  rm -f "'$1'/pin"
  else
  echo > "'$1'/pin"
  fi
  """
  '
fi

if [ "$google_text" ]; then
echo '
  [[group]]
  [[menu]]
  [[menu.items]]
  title = "Gemini"
  get = "glog transai_text_'$id'"
  reload = true
  silent = true
  type = "checkbox"
  script = """
  if [ "$(glog transai_text_'$id')" == 1 ]; then
  slog transai_text_'$id' 0
  else
  transai -c && slog transai_text_'$id' 1 || showbanner -y "error" -t "Gemini" -m "'$warn_gemini_text'"
  fi
  """
  '
fi
